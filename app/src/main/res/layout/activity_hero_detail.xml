<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A1A1A"
            android:padding="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout android:layout_width="72dp" android:layout_height="72dp">
                <ImageView android:id="@+id/ivDetailIcon"
                    android:layout_width="72dp" android:layout_height="72dp"
                    android:scaleType="centerCrop" android:background="#2A2A2A"/>
                <TextView android:id="@+id/btnChangeIcon"
                    android:layout_width="match_parent" android:layout_height="20dp"
                    android:layout_gravity="bottom" android:background="#CC000000"
                    android:text="เปลี่ยน" android:textColor="#FFFFFF"
                    android:textSize="10sp" android:gravity="center"/>
            </FrameLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="14dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/tvDetailName"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textColor="#FFFFFF"
                        android:textSize="22sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvDetailTier"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textStyle="bold"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="2dp" android:paddingBottom="2dp"
                        android:background="#2A2200"/>
                </LinearLayout>

                <TextView android:id="@+id/tvDetailRole"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textColor="#888888" android:textSize="13sp"/>
                <TextView android:id="@+id/tvDetailTags"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:textColor="#60A5FA" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Patch banner -->
        <LinearLayout android:id="@+id/rowPatch"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="8dp" android:paddingBottom="8dp"
            android:background="#111" android:layout_marginTop="1dp"
            android:visibility="gone">
            <TextView android:id="@+id/tvPatchStatus"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textStyle="bold"
                android:paddingStart="8dp" android:paddingEnd="8dp"
                android:paddingTop="2dp" android:paddingBottom="2dp"/>
            <TextView android:id="@+id/tvPatchVersion"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#666" android:textSize="11sp" android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Patch changes -->
        <LinearLayout android:id="@+id/sectionPatch"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="4dp" android:paddingBottom="8dp"
            android:background="#0A0A0A" android:visibility="gone">
            <TextView android:id="@+id/tvPatchChanges"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#CCCCCC" android:textSize="12sp" android:lineSpacingMultiplier="1.5"/>
        </LinearLayout>

        <!-- Pro stats -->
        <LinearLayout android:id="@+id/rowStats"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:background="#141414"
            android:layout_marginTop="1dp" android:visibility="gone">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:gravity="center" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="วิน%" android:textColor="#666" android:textSize="10sp"/>
                <TextView android:id="@+id/tvWin" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="#4ADE80"
                    android:textSize="16sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:gravity="center" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="พิก%" android:textColor="#666" android:textSize="10sp"/>
                <TextView android:id="@+id/tvPick" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="#60A5FA"
                    android:textSize="16sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:gravity="center" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="แบน%" android:textColor="#666" android:textSize="10sp"/>
                <TextView android:id="@+id/tvBan" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="#F87171"
                    android:textSize="16sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Strengths -->
        <LinearLayout android:id="@+id/sectionStrengths"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="10dp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="✓ จุดแข็ง" android:textColor="#4ADE80"
                android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
            <TextView android:id="@+id/tvStrengths"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#CCCCCC" android:textSize="13sp" android:lineSpacingMultiplier="1.6"/>
        </LinearLayout>

        <!-- Weaknesses -->
        <LinearLayout android:id="@+id/sectionWeaknesses"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="10dp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="✕ จุดอ่อน" android:textColor="#F87171"
                android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
            <TextView android:id="@+id/tvWeaknesses"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#CCCCCC" android:textSize="13sp" android:lineSpacingMultiplier="1.6"/>
        </LinearLayout>

        <!-- Counters -->
        <LinearLayout android:id="@+id/sectionCounters"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="10dp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⚔️ แข็งใส่" android:textColor="#888" android:textSize="11sp"
                android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/tvCounters"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#4ADE80" android:textSize="13sp" android:lineSpacingMultiplier="1.4"/>
        </LinearLayout>

        <!-- WeakTo -->
        <LinearLayout android:id="@+id/sectionWeakTo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="10dp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🛡️ กลัวเจอ" android:textColor="#888" android:textSize="11sp"
                android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/tvWeakTo"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#F87171" android:textSize="13sp" android:lineSpacingMultiplier="1.4"/>
        </LinearLayout>

        <!-- Synergies -->
        <LinearLayout android:id="@+id/sectionSynergies"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="10dp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🤝 เข้าขาดีสุด" android:textColor="#888" android:textSize="11sp"
                android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/tvSynergies"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FACC15" android:textSize="13sp" android:lineSpacingMultiplier="1.4"/>
        </LinearLayout>

        <!-- Skills -->
        <LinearLayout android:id="@+id/sectionSkills"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="12dp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🎯 สกิล" android:textColor="#888" android:textSize="11sp"
                android:layout_marginBottom="8dp"/>
            <LinearLayout android:id="@+id/skillContainer"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>

        <!-- Change icon panel -->
        <LinearLayout android:id="@+id/panelChangeIcon"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="#1A1A1A"
            android:layout_marginTop="12dp" android:padding="14dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="เปลี่ยน icon" android:textColor="#888" android:textSize="11sp"
                android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/etIconUrl"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="URL รูปภาพ (https://...)" android:textColorHint="#555"
                android:textColor="#FFF" android:textSize="12sp" android:background="#2A2A2A"
                android:padding="10dp" android:inputType="textUri" android:singleLine="true"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="8dp">
                <Button android:id="@+id/btnPickFromGallery"
                    android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                    android:text="📁 เลือกจากเครื่อง" android:textSize="12sp"
                    android:backgroundTint="#2A2A2A" android:layout_marginEnd="6dp"/>
                <Button android:id="@+id/btnSaveIcon"
                    android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                    android:text="บันทึก" android:textSize="12sp" android:backgroundTint="#1D9E75"/>
            </LinearLayout>
            <Button android:id="@+id/btnResetIcon"
                android:layout_width="match_parent" android:layout_height="36dp"
                android:layout_marginTop="6dp" android:text="รีเซ็ตเป็นค่าเดิม"
                android:textSize="11sp" android:backgroundTint="#2A1A1A"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
